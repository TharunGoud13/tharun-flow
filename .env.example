# tharun-flow environment configuration template
# Copy this file to .env.local or set these variables in your deployment environment (e.g. Vercel)
# DO NOT COMMIT SENSITIVE KEYS OR CREDENTIALS TO VERSION CONTROL

MODE="development"

# Canvas backend service URLs
VITE_APP_BACKEND_V2_GET_URL=https://json-dev.excalidraw.com/api/v2/
VITE_APP_BACKEND_V2_POST_URL=https://json-dev.excalidraw.com/api/v2/post/

# Excalidraw libraries directory & backend
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

# Optional collaboration WebSocket server
VITE_APP_WS_SERVER_URL=http://localhost:3002

# Optional AI service URL
VITE_APP_AI_BACKEND=http://localhost:3016

# Firebase configuration for cloud persistence
# Replace with your Firebase project credentials in .env.local
VITE_APP_FIREBASE_CONFIG='{"apiKey":"YOUR_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT_ID","storageBucket":"YOUR_PROJECT.appspot.com","messagingSenderId":"YOUR_MESSAGING_SENDER_ID","appId":"YOUR_APP_ID"}'

# Feature flags
VITE_APP_ENABLE_TRACKING=false
VITE_APP_PORT=3000
VITE_APP_ENABLE_PWA=false
VITE_APP_ENABLE_ESLINT=false
